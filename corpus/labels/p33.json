   "rules": [
    "pseudo-cognition"
   ],
   "reasons": {
    "pseudo-cognition": "「原因の解像度を上げるため」。ログを追加する目的を「解像度を上げる」と言っており、画像などの文字どおりの解像度ではない。何を知りたかったのかの中身がない"
   }
  },
